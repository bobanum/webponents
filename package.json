{
  "name": "@bobanum/webponents",
  "version": "1.0.0",
  "description": "Webponents - vanilla JS project using node modules (bundled with esbuild)",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "unpkg": "dist/bundle.standalone.min.js",
  "jsdelivr": "dist/bundle.standalone.min.js",
  "exports": {
    ".": {
      "browser": "./dist/bundle.standalone.min.js",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "esbuild index.js --bundle --servedir=examples --outfile=examples/bundle.js --sourcemap --loader:.css=text",
    "build": "npm run build:rollup && npm run build:esbuild",
    "build:rollup": "rollup -c",
    "build:esbuild": "esbuild index.js --bundle --minify --outfile=examples/bundle.js --loader:.css=text",
    "watch": "rollup -c -w",
    "prepublishOnly": "npm run build:rollup",
    "publish:gh-pages": "npm run build:esbuild && npx gh-pages -d examples"
  },
  "keywords": [
    "module",
    "vanilla-js",
    "lightweight",
    "webcomponents"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "esbuild": "^0.27.2",
    "gh-pages": "^5.0.0",
    "rollup": "^4.30.1",
    "rollup-plugin-postcss": "^4.0.2"
  }
}
